{
  "name": "youtube-transcript-viewer",
  "version": "1.0.0",
  "main": "dist/src/main/index.js",
  "scripts": {
    "css": "npx tailwindcss -i src/input.css -o dist/output.css",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "esbuild src/renderer/index.ts --bundle --outfile=dist/renderer.js --platform=browser --target=es2020 --format=iife",
    "build": "npm run css && npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Download YouTube videos and view synced transcripts",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "electron": "^41.0.2",
    "esbuild": "^0.27.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.8.0"
  }
}
