# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Media (large files)
*.mp3
*.mp4
*.webm

# Public symlinks / generated media
public/audio
public/img
public/video.mp4
public/transcript.srt

# Generated decks & user data
*.apkg
subs2srs_deck/
mencho_deck/
user_cards.json
*.srt

# Python
__pycache__/
*.pyc
venv/
.venv/
.claude/
